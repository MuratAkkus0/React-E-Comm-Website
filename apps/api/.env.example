PORT=9000
NODE_ENV=development

# postgresql://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql://ecomm_user:ecomm_pass@localhost:5432/ecomm_db

# Generate a real secret for anything beyond local dev, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Only the access token is a signed JWT; refresh tokens are opaque random
# strings stored hashed in the DB, so there is no REFRESH_TOKEN_SECRET.
ACCESS_TOKEN_SECRET=dev-only-access-secret-change-me-please
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list of origins allowed to call this API with credentials.
CORS_ORIGIN=http://localhost:5173

# Only used by docker-compose to provision the postgres container.
POSTGRES_USER=ecomm_user
POSTGRES_PASSWORD=ecomm_pass
POSTGRES_DB=ecomm_db
